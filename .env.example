# Set these as environment variables (the app does not read .env automatically;
# on Windows put them in run.bat, on macOS/Linux `export` them or use `set -a; . .env`).
# Everything is optional: with no key the app runs on offline templates.

# Free Gemini keys: https://aistudio.google.com/apikey  (comma-separated; tried in order)
GEMINI_API_KEYS=
# Pin a model instead of auto-discovery
# CHAT_GEMINI_MODEL=gemini-2.5-flash
# Force offline templates
# AI_PROVIDER=template

# Flask
SECRET_KEY=change-me
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000

# Optional email drafts (Gmail needs an App Password)
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
